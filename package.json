{
  "name": "ux-laws-reviewer",
  "version": "3.0.0",
  "description": "An AI agent skill for reviewing UIs against 25+ psychological UX laws, WCAG 2.2 accessibility criteria, and Nielsen's 10 usability heuristics — with quantitative 0-100 scoring and self-evolution.",
  "bin": {
    "ux-laws-reviewer": "install.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check-refs": "node evals/eval_runner.js --check",
    "generate-manifest": "node scripts/generate-manifest.js",
    "verify-manifest": "node scripts/generate-manifest.js --verify"
  },
  "keywords": [
    "claude-code",
    "claude",
    "gemini",
    "cursor",
    "windsurf",
    "ai-agent",
    "skill",
    "ux",
    "ui",
    "user-experience",
    "ux-laws",
    "ux-review",
    "ux-audit",
    "design-review",
    "heuristic-evaluation",
    "accessibility",
    "wcag",
    "wcag-2.2",
    "a11y",
    "hick-law",
    "fitts-law",
    "gestalt",
    "cognitive-load",
    "nielsen-heuristics",
    "frontend"
  ],
  "author": "Zendevve",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zendevve/ux-laws-reviewer.git"
  },
  "homepage": "https://github.com/Zendevve/ux-laws-reviewer#readme",
